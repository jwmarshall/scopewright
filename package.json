{
  "name": "@jwmarshall/scopewright",
  "version": "0.3.0",
  "description": "SCOPED read-only reviewers for Claude Code, Codex, Pi, OhMyPi, Antigravity CLI, legacy Gemini CLI, OpenCode, and Cursor.",
  "author": "Jonathon W. Marshall <jonathon.marshall@gmail.com> (https://github.com/jwmarshall)",
  "license": "MIT",
  "keywords": ["pi-package", "agent-skills", "codex", "oh-my-pi", "antigravity", "gemini-cli", "opencode", "cursor", "code-review", "scoped"],
  "bin": {
    "scopewright": "scripts/install.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jwmarshall/scopewright.git"
  },
  "homepage": "https://jwmarshall.github.io/scopewright/",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "sync:agents": "node scripts/sync-agents.mjs",
    "check": "node scripts/sync-agents.mjs --check && npm test",
    "test": "node --test tests/*.test.mjs",
    "package:claude": "node scripts/package.mjs claude",
    "package:codex": "node scripts/package.mjs codex",
    "package:pi": "node scripts/package.mjs pi",
    "package:omp": "node scripts/package.mjs omp",
    "package:antigravity": "node scripts/package.mjs antigravity",
    "package:gemini": "node scripts/package.mjs gemini",
    "package:opencode": "node scripts/package.mjs opencode",
    "package:cursor": "node scripts/package.mjs cursor",
    "package:all": "node scripts/package.mjs all"
  },
  "files": [
    "skills/",
    "agents/",
    ".agents/agents/",
    ".antigravity/",
    ".claude/",
    ".claude-plugin/",
    ".cursor-plugin/",
    ".codex/",
    ".cursor/",
    ".gemini/",
    ".opencode/",
    ".omp/",
    "scripts/sync-agents.mjs",
    "scripts/package.mjs",
    "scripts/install.mjs",
    "reference/",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "skills": ["./skills"]
  }
}
