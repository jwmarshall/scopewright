{
  "name": "scopewright",
  "version": "0.2.0",
  "description": "SCOPED read-only reviewers for Claude Code, Codex, Pi, OhMyPi, Antigravity CLI, legacy Gemini CLI, OpenCode, and Cursor.",
  "license": "MIT",
  "keywords": ["pi-package", "agent-skills", "codex", "oh-my-pi", "antigravity", "gemini-cli", "opencode", "cursor", "code-review", "scoped"],
  "scripts": {
    "sync:agents": "node scripts/sync-agents.mjs",
    "check": "node scripts/sync-agents.mjs --check && npm test",
    "test": "node --test tests/*.test.mjs",
    "package:gemini": "node scripts/package-gemini.mjs",
    "package:antigravity": "node scripts/package-antigravity.mjs",
    "package:omp": "node scripts/package-omp.mjs"
  },
  "files": [
    "skills/",
    "agents/",
    ".agents/agents/",
    ".antigravity/",
    ".claude/",
    ".claude-plugin/",
    ".cursor-plugin/",
    ".codex/",
    ".cursor/",
    ".gemini/",
    ".opencode/",
    ".omp/",
    "scripts/sync-agents.mjs",
    "scripts/package-gemini.mjs",
    "scripts/package-antigravity.mjs",
    "scripts/package-omp.mjs",
    "tests/*.test.mjs",
    "reference/",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "skills": ["./skills"]
  }
}
